# Generate a random secret locally; never commit the real .env.
SEARCH_API_TOKEN=
# Opt in only for a public service behind HTTPS and per-IP ingress limits.
SEARCH_PUBLIC=false
# Configure Jackett first, then copy its API key here (not to the browser).
JACKETT_API_KEY=
# Comma-separated IDs of configured, authorized sources; no sources enabled by default.
# Public service uses mikan,dmhy,acgrip,nyaasi,bangumi-moe; verify each on your host first.
JACKETT_INDEXERS=
# Example repository: lscr.io/linuxserver/jackett; choose a verified tag or digest.
JACKETT_IMAGE=
PUID=1000
PGID=1000
