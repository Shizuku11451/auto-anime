#!/bin/bash

# 安装前校验向导输入。失败时把用户可见的错误写进 TRIM_TEMP_LOGFILE 并以非零状态退出。
: "${TRIM_TEMP_LOGFILE:=/dev/null}"

# 内置 BT 引擎在容器内固定监听 10 个连续端口，宿主机端口段长度必须一致，
# 否则 Docker 会以「两侧端口数量不同」拒绝启动。这里与 docker-compose.yaml 的
# 6881-6890 和 NATIVE_BT_PORT 必须保持同一套约定。
bt_ports="${wizard_bt_ports:-6881-6890}"
service_port="${TRIM_SERVICE_PORT:-8000}"

# 不接受前导零：写进 Compose 的端口值原样交给 Docker，06881 这类写法会被拒绝。
if ! printf '%s' "$bt_ports" | grep -Eq '^[1-9][0-9]{0,4}-[1-9][0-9]{0,4}$'; then
    echo "BT 端口段格式应为 起始-结束（如 6881-6890），两端都是 1-65535 的整数，当前值：${bt_ports}" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

bt_start="${bt_ports%%-*}"
bt_end="${bt_ports##*-}"

if [ "$bt_end" -gt 65535 ]; then
    echo "BT 端口段需在 1-65535 之间，当前值：${bt_ports}" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

if [ "$((bt_end - bt_start))" -ne 9 ]; then
    echo "BT 端口段必须是 10 个连续端口（如 6881-6890），当前值：${bt_ports}" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

if [ "$bt_start" -le "$service_port" ] && [ "$service_port" -le "$bt_end" ]; then
    echo "BT 端口段不能包含网页端口 ${service_port}，当前值：${bt_ports}" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# switch 字段在不同版本的飞牛上可能提交 true/false，也可能提交 1/0，这里两种都接受。
keep_source="$(printf '%s' "${wizard_keep_source:-true}" | tr '[:upper:]' '[:lower:]')"
case "$keep_source" in
true | false | 1 | 0 | yes | no | on | off) ;;
*)
    echo "保留下载器原文件做种只能取 true 或 false（1/0 也可），当前值：${wizard_keep_source}" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac

exit 0
