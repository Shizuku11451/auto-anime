#!/bin/bash

# 此脚本仅在宿主机以 root 执行，生成文件和 Docker socket 均不挂进容器。
mount_error() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
    else
        printf '%s\n' "$1" >&2
    fi
    return 1
}

json_path() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    # Compose 会插值 JSON/YAML 中的美元符号。
    value="${value//\$/\$\$}"
    printf '"%s"' "$value"
}

# 飞牛按 config/privilege 的 run-as 重置数据目录属主（run-as=root 时整个目录会被改回 root），
# 而容器以非 root 应用用户运行，属主不对就无法写数据库和运行目录。安装、升级与授权变更后
# 统一改回应用用户；这三个回调都不是高频路径，整目录递归一次可以接受。
ensure_data_owner() {
    local uid="${TRIM_UID:-}" gid="${TRIM_GID:-}" var="${TRIM_PKGVAR:-}"
    local resolved detail
    [[ "$uid" =~ ^[1-9][0-9]*$ && "$gid" =~ ^[0-9]+$ ]] || { mount_error '缺少有效的非 root 应用用户'; return 1; }
    [[ "$var" = /* ]] && [ -d "$var" ] || { mount_error '应用数据目录不存在或不是绝对路径'; return 1; }
    resolved="$(readlink -f -- "$var")" || { mount_error '无法解析应用数据目录'; return 1; }
    [ -n "$resolved" ] && [ "$resolved" != / ] || { mount_error '不能修改根目录属主'; return 1; }
    if ! detail="$(chown -R -- "$uid:$gid" "$resolved" 2>&1)"; then
        mount_error "无法恢复应用数据目录属主，请检查存储空间是否只读及目录权限：$resolved；$detail"
        return 1
    fi
}

prepare_mounts() {
    local uid="${TRIM_UID:-}" gid="${TRIM_GID:-}" path resolved tmp prefix
    [[ "$uid" =~ ^[1-9][0-9]*$ && "$gid" =~ ^[0-9]+$ ]] || { mount_error '缺少有效的非 root 应用用户'; return 1; }
    local output="${TRIM_PKGETC:?}/authorized-mounts.json"
    tmp="$(mktemp "${TRIM_PKGETC}/.mounts-XXXXXX")" || return 1
    chmod 600 "$tmp"
    printf '{"services":{"auto-anime":{"volumes":[' > "$tmp"
    prefix=''
    local -a paths
    IFS=: read -r -a paths <<< "${TRIM_DATA_ACCESSIBLE_PATHS:-}"
    for path in "${paths[@]}"; do
        [ -n "$path" ] || continue
        # 只接受存储空间下的具体目录；拒绝系统目录及包目录的任何别名。
        if [[ "$path" =~ [[:cntrl:]] ]]; then
            rm -f "$tmp"; mount_error '授权目录包含不支持的控制字符'; return 1
        fi
        resolved="$(readlink -f -- "$path")" || resolved=''
        case "$resolved" in
            /vol[0-9]*/@* | /vol[0-9]*/thumb | /vol[0-9]*/thumb/* | /vol[0-9]*/mediasrv.* | /vol[0-9]*/appcenter-downloads*)
                rm -f "$tmp"; mount_error "不能挂载飞牛系统或应用目录：$path"; return 1 ;;
        esac
        if [[ ! "$resolved" =~ ^/vol[1-9][0-9]*/[^/]+(/.*)?$ ]] || [ ! -d "$resolved" ] || [ "$resolved" != "$path" ]; then
            rm -f "$tmp"; mount_error "授权目录不存在、含软链或不是存储空间下的具体目录：$path"; return 1
        fi
        printf '%s{"type":"bind","source":' "$prefix" >> "$tmp"
        json_path "$resolved" >> "$tmp"
        printf ',"target":' >> "$tmp"
        json_path "$resolved" >> "$tmp"
        printf ',"bind":{"create_host_path":false}}' >> "$tmp"
        prefix=','
    done
    printf ']}}}\n' >> "$tmp"
    mv -f -- "$tmp" "$output"
}

run_compose() {
    local base="${TRIM_APPDEST:-}/docker/docker-compose.yaml"
    local mounts="${TRIM_PKGETC:-}/authorized-mounts.json"
    local output status reason
    command -v docker >/dev/null 2>&1 || { mount_error '找不到 Docker，请先安装并启动飞牛 Docker 应用。'; return 1; }
    [ -n "${TRIM_APPDEST:-}" ] && [ -f "$base" ] || { mount_error '应用容器配置缺失，请重新下载对应版本的正式安装包。'; return 1; }
    output="$(mktemp)" || { mount_error '无法创建启动日志，请检查临时目录权限与剩余空间。'; return 1; }
    # 保留完整 Docker 输出供应用日志排查，安装弹窗只写分类提示，避免泄露配置。
    if [ -f "$mounts" ]; then
        docker compose --project-name "${TRIM_APPNAME:-auto-anime}" -f "$base" -f "$mounts" "$@" >"$output" 2>&1
    else
        docker compose --project-name "${TRIM_APPNAME:-auto-anime}" -f "$base" "$@" >"$output" 2>&1
    fi
    status=$?
    cat "$output"
    if [ "$status" -ne 0 ]; then
        reason='Docker 操作失败，请查看应用日志。'
        if grep -Eqi 'unauthorized|denied:|authentication required|forbidden' "$output"; then
            reason='镜像访问被拒绝。正式镜像必须允许匿名拉取；请确认下载的是官方正式包，或联系维护者检查镜像公开权限。'
        elif grep -Eqi 'no such image|manifest unknown|manifest.*not found|not found.*manifest|no matching manifest' "$output"; then
            reason='对应版本或架构的镜像不存在。请重新下载已正式发布的配套安装包；本地测试包必须先准备指定镜像。'
        elif grep -Eqi 'port is already allocated|address already in use|failed to bind host port|bind.*port.*failed' "$output"; then
            reason='网页或 BT 端口已被占用。请停止冲突服务，或在安装向导换一段 BT 端口。'
        elif grep -Eqi 'no space left|read-only file system|permission denied|mount.*(not exist|not found)|invalid mount' "$output"; then
            reason='存储空间、目录权限或挂载异常。请检查剩余空间、应用数据目录和授权目录。'
        elif grep -Eqi 'unhealthy|did not become healthy|health.*timeout|timeout.*health|container.*exited' "$output"; then
            reason='容器未能在 120 秒内健康启动。请查看应用及容器日志；不要删除原数据目录。'
        elif grep -Eqi 'timeout|timed out|TLS|x509|no such host|connection refused|network is unreachable|connection reset|unexpected EOF' "$output"; then
            reason='镜像仓库网络连接失败。请检查 NAS 的 DNS、网络与 Docker 镜像获取配置；网页代理设置不能帮助 Docker 拉取镜像。'
        elif grep -Eqi 'cannot connect.*docker|docker daemon.*not running' "$output"; then
            reason='Docker 服务不可用，请先启动飞牛 Docker 应用。'
        fi
        mount_error "$reason 日志位置：/var/log/apps/${TRIM_APPNAME:-auto-anime}.log（退出码 $status）。"
    fi
    rm -f -- "$output"
    return "$status"
}
