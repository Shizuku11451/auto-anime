# 仅发送根 Dockerfile 实际使用的源码、依赖清单、前端产物与入口脚本。
# 发布镜像使用 image-context/ 内独立生成的上下文，不使用此文件。
**
!Dockerfile
!backend/
!backend/*.go
!backend/go.mod
!backend/go.sum
!backend/internal/
!backend/internal/**
!backend/cmd/
!backend/cmd/search-server/
!backend/cmd/search-server/*.go
!backend/third_party/
!backend/third_party/**
!backend/static/
!backend/static/**
!scripts/
!scripts/docker-entrypoint.sh
!deploy/
!deploy/search/
!deploy/search/Dockerfile
